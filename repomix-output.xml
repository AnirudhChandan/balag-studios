<file path="src/index.css">
@tailwind base;
@tailwind components;
@tailwind utilities;

body {
  background-color: #0a0a0a;
  color: #f5f5f5;
  font-family: "Montserrat", sans-serif;
  overflow-x: hidden;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: "Playfair Display", serif;
}

/* --- NEW: High-Impact Typography Utilities --- */

/* Creates the hollow text effect */
.stroke-text {
  -webkit-text-stroke: 1px rgba(255, 255, 255, 0.8);
  color: transparent;
}

/* Ensure canvas doesn't capture scroll if we don't want it to */
canvas {
  touch-action: none;
}

.slider-thumb-gold::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #d4af37; /* Luxury Gold */
  border: 2px solid white;
  cursor: pointer;
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
  transition: transform 0.2s;
}

.slider-thumb-gold::-webkit-slider-thumb:hover {
  transform: scale(1.2);
}

.slider-thumb-gold::-moz-range-thumb {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background: #d4af37;
  border: 2px solid white;
  cursor: pointer;
  box-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
}

.narrative-input {
  background: transparent;
  border: none;
  border-bottom: 1px solid #555;
  color: #d4af37; /* Luxury Gold */
  font-family:
    "Montserrat", sans-serif; /* Sans-serif for contrast against the Serif body */
  font-weight: 600;
  padding: 0 0.5rem;
  outline: none;
  transition: all 0.3s ease;
  min-width: 150px;
  text-align: center;
}

.narrative-input:focus {
  border-bottom: 1px solid #d4af37;
  background: rgba(212, 175, 55, 0.05);
}

.narrative-input::placeholder {
  color: rgba(255, 255, 255, 0.2);
  font-weight: 400;
  text-transform: uppercase;
  font-size: 0.75rem;
  letter-spacing: 0.1em;
}

/* Hide date picker icon usually, but keep it accessible */
.narrative-input[type="date"]::-webkit-calendar-picker-indicator {
  filter: invert(1);
  opacity: 0.5;
  cursor: pointer;
}

@keyframes equalizer {
  0% {
    height: 20%;
  }
  50% {
    height: 100%;
  }
  100% {
    height: 20%;
  }
}

.animate-equalizer {
  animation: equalizer 1s ease-in-out infinite;
}

/* Delays for different bars so they don't move in sync */
.delay-100 {
  animation-delay: 0.1s;
}
.delay-200 {
  animation-delay: 0.2s;
}
.delay-300 {
  animation-delay: 0.3s;
}
