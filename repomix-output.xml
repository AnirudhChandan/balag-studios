<file path="src/components/Hero.jsx">
import { useEffect, useRef, useMemo, useState } from "react";
import { Canvas, useFrame, useThree } from "@react-three/fiber";
import { useAspect, useVideoTexture } from "@react-three/drei";
import { motion } from "framer-motion";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { useGSAP } from "@gsap/react";
import * as THREE from "three";
import RevealText from "./RevealText";

// Register GSAP plugins
gsap.registerPlugin(ScrollTrigger);

// --- SHADER: The "Physical Lens" Distortion & Chromatic Aberration ---
const LensDistortionShader = {
  uniforms: {
    uTexture: { value: null },
    uMouse: { value: new THREE.Vector2(0, 0) },
    uVelo: { value: 0 }, // Mouse velocity for intensity
    uScale: { value: new THREE.Vector2(1, 1) },
  },
  vertexShader: `
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `,
  fragmentShader: `
    uniform sampler2D uTexture;
    uniform vec2 uMouse;
    uniform float uVelo;
    varying vec2 vUv;

    // Aberration intensity
    float aberration = 0.015; 

    void main() {
      vec2 uv = vUv;
      
      // Calculate distance from mouse pointer
      vec2 dist = uv - uMouse;
      float d = length(dist);

      // Create a "bulge" effect based on mouse distance and velocity
      // The 1.2 mimics a f/1.2 lens curvature
      float lensEffect = smoothstep(0.6, 0.0, d) * uVelo * 0.1;
      
      // Distort UVs
      uv += dist * lensEffect;

      // Chromatic Aberration (RGB Shift)
      // We sample the texture 3 times with slight offsets to create the "rainbow" edge
      vec4 r = texture2D(uTexture, uv + vec2(aberration * uVelo, 0.0));
      vec4 g = texture2D(uTexture, uv);
      vec4 b = texture2D(uTexture, uv - vec2(aberration * uVelo, 0.0));

      gl_FragColor = vec4(r.r, g.g, b.b, 1.0);
    }
  `,
};

// --- COMPONENT: The 3D Video Plane ---
const CinematicVideo = ({ videoUrl }) => {
  const meshRef = useRef();
  const texture = useVideoTexture(videoUrl);
  const { viewport } = useThree();

  // Calculate aspect ratio to cover the screen without stretching
  const scale = useAspect(1920, 1080, 1); // Assuming 1080p video

  // Shader Uniforms Reference
  const uniforms = useMemo(
    () => ({
      uTexture: { value: texture },
      uMouse: { value: new THREE.Vector2(0, 0) },
      uVelo: { value: 0 },
    }),
    [texture],
  );

  // Mouse tracking logic for the shader
  useFrame((state) => {
    if (!meshRef.current) return;

    // Convert mouse range from [-1, 1] to [0, 1] for UV space
    const targetX = (state.pointer.x + 1) / 2;
    const targetY = (state.pointer.y + 1) / 2;

    // Smoothly interpolate (Lerp) current values to target for "heavy" feel
    uniforms.uMouse.value.x = THREE.MathUtils.lerp(
      uniforms.uMouse.value.x,
      targetX,
      0.05,
    );
    uniforms.uMouse.value.y = THREE.MathUtils.lerp(
      uniforms.uMouse.value.y,
      targetY,
      0.05,
    );

    // Calculate "velocity" (how fast mouse is moving) to trigger distortion intensity
    const velo = Math.abs(state.pointer.x - uniforms.uMouse.value.x * 2 + 1);
    uniforms.uVelo.value = THREE.MathUtils.lerp(
      uniforms.uVelo.value,
      velo * 4, // Multiplier for sensitivity
      0.1,
    );
  });

  return (
    <mesh ref={meshRef} scale={scale}>
      <planeGeometry args={[1, 1, 32, 32]} />
      <shaderMaterial
        fragmentShader={LensDistortionShader.fragmentShader}
        vertexShader={LensDistortionShader.vertexShader}
        uniforms={uniforms}
        wireframe={false}
      />
    </mesh>
  );
};

// --- MAIN COMPONENT: Hero ---
const Hero = () => {
  const containerRef = useRef(null);
  const canvasWrapperRef = useRef(null);
  const textRef = useRef(null);

  useGSAP(() => {
    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: containerRef.current,
        start: "top top", // Start animation when hero hits top
        end: "+=150%", // Scroll distance to complete the shrink
        pin: true, // Lock the hero in place while animating
        scrub: 1, // Smooth scrubbing effect
        // markers: true, // Uncomment to debug start/end points
      },
    });

    // 1. Shrink the video container into a "Gallery Frame"
    tl.to(
      canvasWrapperRef.current,
      {
        scale: 0.6, // Shrink to 60% size
        borderRadius: "12px", // Add rounded corners
        y: "10vh", // Move it down slightly
        ease: "power2.inOut",
      },
      0,
    );

    // 2. Fade out and move the oversized text
    tl.to(
      textRef.current,
      {
        y: -100,
        opacity: 0,
        scale: 0.9,
        ease: "power2.in",
      },
      0,
    );
  }, []);

  return (
    <div
      ref={containerRef}
      className="relative w-full h-screen bg-luxury-black overflow-hidden"
    >
      {/* 3D CANVAS LAYER */}
      <div
        ref={canvasWrapperRef}
        className="absolute inset-0 w-full h-full z-0 overflow-hidden shadow-2xl"
      >
        <Canvas gl={{ antialias: true, alpha: false }} dpr={[1, 1.5]}>
          <CinematicVideo videoUrl="/hero.mp4" />
        </Canvas>

        {/* Dark overlay for text readability */}
        <div className="absolute inset-0 bg-black/20 pointer-events-none" />
      </div>

      {/* TYPOGRAPHY LAYER */}
      <div
        ref={textRef}
        className="relative z-10 w-full h-full flex flex-col items-center justify-center pointer-events-none mix-blend-difference"
      >
        <div className="text-center">
          <motion.div
            initial={{ opacity: 0, scale: 1.1 }}
            animate={{ opacity: 1, scale: 1 }}
            transition={{ duration: 1.5, ease: "easeOut" }}
          >
            <h1 className="font-serif text-[12vw] md:text-[14vw] leading-[0.85] text-white uppercase tracking-tighter">
              BalaG
            </h1>
            <h1 className="font-serif text-[12vw] md:text-[14vw] leading-[0.85] text-transparent stroke-text uppercase tracking-tighter">
              Studios
            </h1>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 1, duration: 1 }}
            className="mt-8 flex justify-between items-center w-full max-w-lg mx-auto px-4"
          >
            <span className="text-luxury-gold text-xs uppercase tracking-[0.4em]">
              Est. 2015
            </span>
            <span className="text-luxury-gold text-xs uppercase tracking-[0.4em]">
              Rishikesh
            </span>
          </motion.div>
        </div>
      </div>
    </div>
  );
};

export default Hero;
</file>

