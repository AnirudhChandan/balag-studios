import { useRef, useState, useMemo, useEffect } from "react";
import { motion, useScroll, useTransform } from "framer-motion";
import { Canvas, useFrame } from "@react-three/fiber";
import { useTexture } from "@react-three/drei";
import * as THREE from "three";
import { galleryImages } from "../data/photos";
import RevealText from "./RevealText";

// --- 1. THE GLSL LIQUID SHADER MATERIAL ---
const LiquidShaderMaterial = {
  uniforms: {
    uTexture: { value: null },
    uHover: { value: 0 },
    uTime: { value: 0 },
  },
  vertexShader: `
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
    }
  `,
  fragmentShader: `
    uniform sampler2D uTexture;
    uniform float uHover;
    uniform float uTime;
    varying vec2 vUv;

    // Simplex noise function
    float noise(vec2 p) {
      return sin(p.x * 10.0 + uTime) * cos(p.y * 10.0 + uTime);
    }

    void main() {
      vec2 uv = vUv;
      
      // Calculate Wave / Liquid Distortion
      // Only apply when uHover > 0
      float wave = noise(uv + uTime * 0.5) * uHover * 0.02;
      
      // Apply distortion to UVs
      vec2 distortedUV = uv + vec2(wave, wave * 0.5);

      vec4 color = texture2D(uTexture, distortedUV);
      
      // Add a subtle RGB shift on edges for "Heat Haze" feel
      if(uHover > 0.0) {
        float shift = uHover * 0.01;
        color.r = texture2D(uTexture, distortedUV + vec2(shift, 0.0)).r;
        color.b = texture2D(uTexture, distortedUV - vec2(shift, 0.0)).b;
      }

      gl_FragColor = color;
    }
  `,
};

// --- 2. SINGLE IMAGE COMPONENT (WebGL) ---
const ShaderImage = ({ url, isHovered }) => {
  const meshRef = useRef();
  const materialRef = useRef();

  // 1. Load the raw texture
  const rawTexture = useTexture(url);

  // 2. Clone it to satisfy the linter.
  // Cloning shares the image data, so it is performant, but gives us a mutable object.
  const texture = useMemo(() => {
    const cloned = rawTexture.clone();
    cloned.minFilter = THREE.LinearFilter;
    cloned.needsUpdate = true;
    return cloned;
  }, [rawTexture]);

  const uniforms = useMemo(
    () => ({
      uTexture: { value: texture },
      uHover: { value: 0 },
      uTime: { value: 0 },
    }),
    [texture],
  );

  useFrame((state) => {
    if (materialRef.current) {
      // Modify the MATERIAL uniforms, not the hook variable
      materialRef.current.uniforms.uHover.value = THREE.MathUtils.lerp(
        materialRef.current.uniforms.uHover.value,
        isHovered ? 1 : 0,
        0.1,
      );

      materialRef.current.uniforms.uTime.value = state.clock.getElapsedTime();
    }
  });

  return (
    <mesh ref={meshRef}>
      <planeGeometry args={[2, 3, 32, 32]} />
      <shaderMaterial
        ref={materialRef}
        fragmentShader={LiquidShaderMaterial.fragmentShader}
        vertexShader={LiquidShaderMaterial.vertexShader}
        uniforms={uniforms}
      />
    </mesh>
  );
};

// --- 3. THE CARD COMPONENT (DOM + WebGL Wrapper) ---
const GalleryItem = ({ image }) => {
  const [hovered, setHovered] = useState(false);

  return (
    <div
      className="relative w-full aspect-[2/3] mb-12 group cursor-pointer"
      onMouseEnter={() => setHovered(true)}
      onMouseLeave={() => setHovered(false)}
    >
      {/* WEBGL LAYER */}
      <div className="absolute inset-0 w-full h-full z-0 pointer-events-none">
        <Canvas gl={{ alpha: true, antialias: true }} dpr={[1, 1.5]}>
          <ShaderImage url={image.url} isHovered={hovered} />
        </Canvas>
      </div>

      {/* OVERLAY: TECHNICAL META */}
      <div className="absolute inset-0 z-10 p-6 flex flex-col justify-between opacity-0 group-hover:opacity-100 transition-opacity duration-500 bg-black/20">
        <div className="flex justify-between items-start">
          <span className="text-[10px] text-white/80 uppercase tracking-widest border border-white/20 px-2 py-1 backdrop-blur-md">
            {image.category}
          </span>
        </div>

        <div className="text-right">
          <div className="space-y-1 mb-4 translate-y-4 group-hover:translate-y-0 transition-transform duration-500 delay-100">
            {image.meta && (
              <>
                <p className="text-luxury-gold text-xs font-mono">
                  {image.meta.lens} • {image.meta.aperture}
                </p>
                <p className="text-gray-300 text-[10px] uppercase tracking-widest">
                  {image.meta.location} • ISO {image.meta.iso}
                </p>
              </>
            )}
          </div>

          <h3 className="font-serif text-3xl text-white translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
            {image.title}
          </h3>
        </div>
      </div>
    </div>
  );
};

// --- 4. MAIN LAYOUT: ASYMMETRIC SCROLL ---
const LivingGallery = () => {
  const containerRef = useRef(null);

  const { scrollYProgress } = useScroll({
    target: containerRef,
    offset: ["start end", "end start"],
  });

  const y1 = useTransform(scrollYProgress, [0, 1], [0, -100]);
  const y2 = useTransform(scrollYProgress, [0, 1], [0, -200]);
  const y3 = useTransform(scrollYProgress, [0, 1], [0, -50]);

  const col1 = galleryImages.filter((_, i) => i % 3 === 0);
  const col2 = galleryImages.filter((_, i) => i % 3 === 1);
  const col3 = galleryImages.filter((_, i) => i % 3 === 2);

  return (
    <section
      ref={containerRef}
      className="bg-luxury-black min-h-screen py-32 px-4 md:px-10 overflow-hidden"
    >
      <div className="max-w-7xl mx-auto mb-24 text-center">
        <h2 className="text-luxury-gold uppercase tracking-[0.2em] text-sm mb-4">
          The Living Gallery
        </h2>
        <RevealText
          text="Moments in Motion"
          className="font-serif text-5xl md:text-7xl text-white justify-center"
        />
      </div>

      <div className="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12">
        <motion.div style={{ y: y1 }} className="flex flex-col pt-0">
          {col1.map((img) => (
            <GalleryItem key={img.id} image={img} />
          ))}
        </motion.div>

        <motion.div style={{ y: y2 }} className="flex flex-col pt-32">
          {col2.map((img) => (
            <GalleryItem key={img.id} image={img} />
          ))}
        </motion.div>

        <motion.div style={{ y: y3 }} className="flex flex-col pt-12">
          {col3.map((img) => (
            <GalleryItem key={img.id} image={img} />
          ))}
        </motion.div>
      </div>
    </section>
  );
};

export default LivingGallery;
</file>

