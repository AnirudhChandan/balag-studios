import { useState } from "react";
import { motion, AnimatePresence } from "framer-motion";
import SEO from "../components/SEO";
import { videoData } from "../data/videos";
import RevealText from "../components/RevealText";

const Films = () => {
  const [activeFilm, setActiveFilm] = useState(videoData[0]);

  return (
    <div className="bg-luxury-black min-h-screen text-white pt-32 pb-20">
      <SEO
        title="Cinematic Films"
        description="Experience the magic in motion. Watch our curated collection of luxury wedding films."
        url="/films"
      />

      <div className="max-w-[95%] mx-auto px-4 md:px-8">
        {/* Header */}
        <div className="mb-16 border-b border-white/10 pb-8">
          <motion.h3
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            className="text-luxury-gold uppercase tracking-[0.3em] text-xs mb-4 font-sans"
          >
            The Screening Room
          </motion.h3>
          <RevealText
            text="Motion & Emotion"
            className="font-serif text-5xl md:text-7xl text-white"
          />
        </div>

        {/* Split Layout */}
        <div className="flex flex-col lg:flex-row gap-12 lg:gap-20 items-start relative">
          {/* LEFT SIDE: The Sticky Player */}
          <div className="w-full lg:w-3/5 sticky top-32 z-20">
            <div className="relative w-full aspect-video bg-black border border-white/10 shadow-2xl rounded-sm overflow-hidden group">
              <AnimatePresence mode="wait">
                <motion.div
                  key={activeFilm.id}
                  initial={{ opacity: 0, filter: "blur(10px)" }}
                  animate={{ opacity: 1, filter: "blur(0px)" }}
                  exit={{ opacity: 0 }}
                  transition={{ duration: 0.5 }}
                  className="w-full h-full"
                >
                  {/* REPLACED WITH IFRAME TO FIX LAG */}
                  <iframe
                    className="absolute top-0 left-0 w-full h-full"
                    src={`https://www.youtube.com/embed/${activeFilm.embedId}?autoplay=1&modestbranding=1&rel=0&showinfo=0`}
                    title={activeFilm.couple}
                    frameBorder="0"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowFullScreen
                  ></iframe>
                </motion.div>
              </AnimatePresence>
            </div>

            {/* Player Metadata */}
            <div className="mt-6 flex justify-between items-end">
              <div>
                <motion.h2
                  key={`title-${activeFilm.id}`}
                  initial={{ opacity: 0, y: 10 }}
                  animate={{ opacity: 1, y: 0 }}
                  className="font-serif text-3xl md:text-4xl text-white mb-1"
                >
                  {activeFilm.couple}
                </motion.h2>
                <motion.p
                  key={`loc-${activeFilm.id}`}
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  className="text-gray-400 font-sans text-sm uppercase tracking-widest"
                >
                  {activeFilm.location}
                </motion.p>
              </div>
              <div className="text-luxury-gold text-xs uppercase tracking-widest font-mono hidden md:block">
                [ {activeFilm.category} ]
              </div>
            </div>
          </div>

          {/* RIGHT SIDE: The Tracklist (REMAINS EXACTLY THE SAME) */}
          <div className="w-full lg:w-2/5 flex flex-col gap-2">
            <h4 className="text-xs uppercase tracking-[0.2em] text-gray-500 mb-4 border-b border-white/10 pb-2">
              Select a Film
            </h4>

            {videoData.map((film, index) => (
              <div
                key={film.id}
                onClick={() => setActiveFilm(film)}
                className={`group cursor-pointer py-6 border-b border-white/5 transition-all duration-500 relative flex justify-between items-center ${
                  activeFilm.id === film.id
                    ? "opacity-100"
                    : "opacity-40 hover:opacity-100"
                }`}
              >
                {/* Active Indicator Line */}
                <div
                  className={`absolute left-0 top-0 h-full w-[2px] bg-luxury-gold transition-transform duration-500 origin-top ${
                    activeFilm.id === film.id
                      ? "scale-y-100"
                      : "scale-y-0 group-hover:scale-y-50"
                  }`}
                />

                <div className="pl-6">
                  <h3
                    className={`font-serif text-2xl md:text-3xl transition-colors duration-500 ${
                      activeFilm.id === film.id
                        ? "text-luxury-gold"
                        : "text-white"
                    }`}
                  >
                    {film.couple}
                  </h3>
                  <p className="text-xs text-gray-400 uppercase tracking-widest mt-2 font-sans">
                    {film.location}
                  </p>
                </div>

                <div className="text-gray-600 font-mono text-sm">
                  0{index + 1}
                </div>
              </div>
            ))}

            <div className="mt-12 p-6 bg-white/5 border border-white/10 rounded-sm text-center">
              <p className="text-sm text-gray-400 font-sans italic">
                *Currently demonstrating layout via YouTube CDN. Final delivery
                will stream natively via Bunny.net without logos.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default Films;
